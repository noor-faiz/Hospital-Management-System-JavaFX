<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="550.0" prefWidth="330.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.finalproject1.UserRegController">
   <children>
      <ImageView fitHeight="93.0" fitWidth="118.0" layoutX="119.0" layoutY="14.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@hospital-logo.jpg" />
         </image>
      </ImageView>
      <Label layoutX="69.0" layoutY="134.0" text="Register Account">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <TextField fx:id="nameText" layoutX="69.0" layoutY="210.0" prefHeight="25.0" prefWidth="193.0" promptText="Name" />
      <PasswordField fx:id="passUserText" layoutX="69.0" layoutY="297.0" prefHeight="25.0" prefWidth="193.0" promptText="Password" />
      <TextField fx:id="userText" layoutX="69.0" layoutY="252.0" prefHeight="25.0" prefWidth="193.0" promptText="Username" />
      <CheckBox layoutX="69.0" layoutY="330.0" mnemonicParsing="false" text="Show Password" />
      <Button layoutX="69.0" layoutY="423.0" mnemonicParsing="false" onAction="#signUp" prefHeight="25.0" prefWidth="193.0" text="Sign Up" />
      <Button layoutX="69.0" layoutY="504.0" mnemonicParsing="false" onAction="#homePageR" text="Go to home page" />
      <Label layoutX="69.0" layoutY="367.0" text="USER TYPE: PATIENT">
         <font>
            <Font name="System Bold" size="12.0" />
